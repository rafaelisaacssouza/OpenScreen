# TURN (recomendado em produção — sem ele, redes corporativas/4G podem falhar)
# Ex.: Metered.ca, Cloudflare Calls TURN, ou coturn próprio
NEXT_PUBLIC_TURN_URL=turn:seu-servidor:3478
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# PeerServer próprio (opcional). Sem isso, usa o servidor público gratuito do PeerJS.
NEXT_PUBLIC_PEER_HOST=
NEXT_PUBLIC_PEER_PORT=443
NEXT_PUBLIC_PEER_PATH=/

# Limites de segurança (padrões seguros; altere com cuidado)
NEXT_PUBLIC_REQUIRE_APPROVAL=true      # anfitrião aprova cada participante antes de entrar na sala
NEXT_PUBLIC_MAX_GUESTS=8               # participantes por sala além do anfitrião
NEXT_PUBLIC_MAX_SESSION_MINUTES=1440     # sala encerra automaticamente após esse tempo
